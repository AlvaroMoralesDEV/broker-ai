{
  "name": "broker-ia",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agente bróker hipotecario e inmobiliario: entrevista, perfil con histórico, viviendas guardadas y cálculo de hipoteca",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "up": "docker compose up -d --build",
    "db": "docker compose up -d db",
    "test": "tsx --test shared/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ollama": "^0.6.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
