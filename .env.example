# Copia este archivo a .env. Lo leen tanto `npm run dev` como `docker compose`.

# --- Agente (Claude API) ---
# https://console.anthropic.com/  ->  API keys. Sin clave funciona todo menos el chat.
ANTHROPIC_API_KEY=
# Modelo del agente (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Base de datos ---
# docker compose: no hace falta tocar nada (usa su propio Postgres).
# npm run dev: vacío = base de datos embebida en data/pglite.
#   Para usar el Postgres de Docker (docker compose up db):
# DATABASE_URL=postgres://broker:broker@localhost:5433/broker
# POSTGRES_PASSWORD=broker

# Puerto del servidor local (opcional)
PORT=8787
