# Copia este archivo a .env y rellena lo que tengas. Todo es opcional:
# sin claves la app funciona igual (calculadora completa + viviendas de EJEMPLO).

# --- Asistente IA (Claude) ---
# https://console.anthropic.com/  ->  API keys
ANTHROPIC_API_KEY=

# --- Idealista (API oficial) ---
# Se pide en https://developers.idealista.com/access-request (te envían apikey + secret por email)
IDEALISTA_API_KEY=
IDEALISTA_SECRET=

# Puerto del servidor local (opcional)
PORT=8787
