# Copia este archivo a .env. Lo leen tanto `npm run dev` como `docker compose`.

# --- Agente (Claude API) ---
# https://console.anthropic.com/  ->  API keys. Sin clave funciona todo menos el chat.
ANTHROPIC_API_KEY=
# Modelo del agente (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Escribe en la consola el consumo de cada petición (tokens de entrada, leídos de caché, salida).
# BROKER_LOG_USAGE=1
# Dominios en los que el agente puede buscar en la web, separados por comas. Vacío = portales
# inmobiliarios y fuentes oficiales (lista en server/agent.ts). "*" = sin restricción.
# WEB_SEARCH_DOMAINS=

# --- IA local (Ollama), cuando no hay clave de Claude ---
# Instala Ollama (https://ollama.com) y ejecuta: ollama pull qwen3:1.7b
# auto (por defecto): Claude si hay clave, si no Ollama, si no modo sin IA. También: anthropic | ollama | none
# LLM_PROVIDER=auto
# Modelo local. Mide antes en tu máquina: node scripts/bench-local.ts <modelo>
# OLLAMA_MODEL=qwen3:1.7b
# Dónde escucha Ollama (para npm run dev). Docker usa host.docker.internal; cámbialo con OLLAMA_HOST_DOCKER.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Base de datos ---
# docker compose: no hace falta tocar nada (usa su propio Postgres).
# npm run dev: vacío = base de datos embebida en data/pglite.
#   Para usar el Postgres de Docker (docker compose up db):
# DATABASE_URL=postgres://broker:broker@localhost:5433/broker
# POSTGRES_PASSWORD=broker

# --- App de Finanzas (repositorio aparte) ---
# Dónde busca el bróker la API de Finanzas (npm run dev; en Docker va por host.docker.internal)
# FINANCE_URL=http://127.0.0.1:8788
# Qué enlace enseña para abrir Finanzas
# FINANCE_PUBLIC_URL=http://finanzas.local

# Puerto del servidor local (opcional)
PORT=8787
